# おっさんのレザークラフト（mpr-shop.com/nori2023）
Options -Indexes
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # 設置フォルダが /nori2023/ 以外の場合はここを書き換える
  RewriteBase /nori2023/

  # 常に https で表示する（エックスサーバー推奨の書き方。手元の確認環境 localhost は除外）
  RewriteCond %{HTTPS} !on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 公開してはいけないフォルダ・ファイル
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # 実在するファイル（CSS・画像など）はそのまま返し、それ以外は index.php へ
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(sql|md|ini|log|sh|lock|json|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
